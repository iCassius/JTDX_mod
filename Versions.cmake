# Version number components
set (WSJTX_VERSION_MAJOR 2)
set (WSJTX_VERSION_MINOR 2)
set (WSJTX_VERSION_32A 0)
set (WSJTX_VERSION_SUB 159)
set (WSJTX_VERSION_TWEAK 30) # Windows PE numeric fourth component; Explorer may omit leading zeroes
set (WSJTX_VERSION_DISPLAY_SUFFIX .030) # P030 user-visible version suffix; increment manually for each candidate
set (WSJTX_RC 0)		 # release candidate number, comment out or zero for development versions
set (WSJTX_VERSION_IS_RELEASE 1) # set to 1 for final release build
